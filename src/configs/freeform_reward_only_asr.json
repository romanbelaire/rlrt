{
  "agent_name": "freeform-reward-only-asr",
  "device": "cuda:0",
  "critic_device": "cuda:0",
  "training": {
    "lr": 0.0005,
    "value_lr": 0.0005,
    "gamma": 0.0,
    "gae_lambda": 0.95,
    "clip": 0.1,
    "eps": 0.2,
    "batch_size": 8,
    "minibatch_size": 8,
    "epochs": 1,
    "episodes": 1,
    "rollout_steps": 8,
    "save_freq": 20,
    "debug_mode": false,
    "entropy_coef": 0.1,
    "kl_coef": 0.5,
    "perplexity_coef": 0.2,
    "base_model_kl_coef": 0.2,
    "seed": 42,
    "alg": "ppo",
    "attack_type": "standard",
    "output_dir": "outputs/reward-only-asr",
    "normalize_advantages": true,
    "max_grad_norm": 1.0,
    "use_gae": true,
    "use_accelerate": false,
    "mixed_precision": "bf16",
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": true,
    "num_gpus": 2,
    "max_gpu_memory": "85GiB",
    "max_cpu_memory": "80GiB",
    "use_offloading": false,
    "use_freeform_high_level": true
  },
  "model": {
    "model_name": "freeform-reward-only-asr",
    "hf_checkpoint": "meta-llama/Llama-3.1-8B-Instruct",
    "action_branches": 1,
    "rejection_candidates": 3,
    "use_high_level_policy": true,
    "high_level_lr": 0.001,
    "keep_base_on_cpu": false,
    "use_lora": true,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj"],
    "target_layers": [0, 4, 8, 12, 16, 20],
    "value_loss_coef": 0.5,
    "sequence_value_coef": 0.5,
    "token_value_coef": 0.5,
    "high_level_policy_type": "freeform",
    "freeform_max_new_tokens": 48,
    "freeform_temperature": 0.8,
    "freeform_top_p": 0.9,
    "hl_critic_selection": true,
    "hl_selection_n_candidates": 5,
    "hl_selection_score_head": "v",
    "quantize": false,
    "use_refusal_suppression": true,
    "enable_forward_hooks": false,
    "forward_hook_clamp_range": 30.0,
    "forward_hook_layernorm_range": 10.0
  },
  "environment": {
    "data_path": "HarmBench/",
    "harm_threshold": 1.9,
    "max_steps": 5,
    "max_new_tokens": 50,
    "batch_size": 8,
    "target_model": "meta-llama/Llama-3.1-8B-Instruct",
    "guard_model": "meta-llama/Llama-Guard-3-8B",
    "warmup_max_new_tokens": 20,
    "target_quantize": false,
    "guard_quantize": false,
    "guard_max_gpu_memory": "20GiB"
  }
}
