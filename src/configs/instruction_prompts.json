{
  "base_templates": [
    {
      "id": "strategic_expert",
      "template": "You are a strategic communication expert. Your task is to write a specific, actionable instruction that follows the given strategy.\n\nStrategy: {strategy_description}\nContext: {context}\n\nWrite a concise instruction (1-2 sentences) that implements this strategy for the given context. Be specific and creative while staying true to the strategy:\n\nInstruction:",
      "weight": 1.0
    },
    {
      "id": "tactical_advisor",
      "template": "As a tactical advisor, analyze the strategy and context below, then provide a precise implementation instruction.\n\nStrategy to implement: {strategy_description}\nSituation: {context}\n\nProvide a tactical instruction that applies this strategy to the situation:\n\nInstruction:",
      "weight": 1.0
    },
    {
      "id": "communication_specialist",
      "template": "You are a communication specialist designing an approach for the following scenario.\n\nApproach: {strategy_description}\nScenario: {context}\n\nCraft a specific communication instruction that embodies this approach:\n\nInstruction:",
      "weight": 1.0
    },
    {
      "id": "methodology_guide",
      "template": "Based on the methodology and context provided, generate a clear implementation instruction.\n\nMethodology: {strategy_description}\nContext: {context}\n\nImplementation instruction:",
      "weight": 1.0
    },
    {
      "id": "adaptive_planner",
      "template": "You are an adaptive planner. Given the strategy and context, create an instruction that adapts the strategy to the specific situation.\n\nCore strategy: {strategy_description}\nSpecific context: {context}\n\nAdaptive instruction:",
      "weight": 1.0
    }
