{
  "agent_name": "default",
  "device": "cuda:0",
  "critic_device": "cuda:0",
  "training": {
    "lr": 5e-3,
    "value_lr": 0.005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip": 0.2,
    "eps": 0.2,
    "batch_size": 8,
    "minibatch_size": 8,
    "epochs": 4,
    "episodes": 250,
    "rollout_steps": 32,
    "save_freq": 20,
    "debug_mode": false,
    "ce_coef": 0.5,
    "kl_coef": 0.1,
    "adv_coef": 0.1,
    "sem_coef": 0.1,
    "perplexity_coef": 0.01,
    "seed": null,
    "alg": "ppo",
    "attack_type": "standard",
    "output_dir": "outputs/70b-target-run",
    "normalize_advantages": true,
    "max_grad_norm": 1.0,
    "target_kl": 0.01,
    "use_gae": true,
    "use_accelerate": true,
    "accelerate_config_path": null,
    "mixed_precision": "fp16",
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": false,
    "offload_optimizer_to_cpu": false,
    "offload_param_to_cpu": false,
    "load_optimizer_states": true,
    "num_masked_marginal_tokens": 3,
    "pairwise_marginal_masking": true,
    "Q_as_reward": false,
    "num_gpus": 1,
    "local_rank": -1,
    "world_size": 1,
    "max_gpu_memory": 0.4,
    "max_cpu_memory": "80GiB",
    "use_offloading": false,
    "warmup_batch_size": 8,
    "use_warmup": true,
    "warmup_rollout_steps": 8
  },
  "model": {
    "model_name": "normal-agent-70b-target",
    "hf_checkpoint": "meta-llama/Llama-3.2-1B-Instruct",
    "action_branches": 1,
    "rejection_candidates": 5,
    "use_high_level_policy": true,
    "high_level_lr": 0.001,
    "keep_base_on_cpu": false,
    "use_lora": true,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "gate_proj"],
    "target_layers": [0, 1, 2, 3, 4],
    "target_model": null,
    "detune": false,
    "value_loss_coef": 0.5,
    "sequence_value_coef": 0.5,
    "token_value_coef": 0.5,
    "attention_divergence_weight": 0.001,
    "adapter_path": null,
    "sequence_critic_path": null,
    "token_critic_path": null,
    "high_level_policy_path": null,
    "merge_adapters": false
  },
  "environment": {
    "data_path": "HarmBench/",
    "harm_threshold": 1.5,
    "max_steps": 3,
    "max_new_tokens": 30,
    "batch_size": 8,
    "target_model": "meta-llama/Llama-3.1-70B-Instruct",
    "guard_model": "meta-llama/Llama-Guard-3-8B",
    "use_custom_reward": false,
    "reward_model_path": null,
    "warmup_max_new_tokens": 20
  }
} 