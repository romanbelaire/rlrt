{
  "agent_name": "debug-test-fast",
  "device": "cuda:0",
  "critic_device": "cuda:0",
  "training": {
    "lr": 5e-05,
    "value_lr": 0.001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip": 0.2,
    "eps": 0.2,
    "batch_size": 2,
    "minibatch_size": 2,
    "epochs": 1,
    "episodes": 2,
    "rollout_steps": 1,
    "save_freq": 1,
    "debug_mode": true,
    "kl_coef": 0.01,
    "perplexity_coef": 0.1,
    "seed": 42,
    "alg": "ppo",
    "attack_type": "standard",
    "output_dir": "outputs/debug-fast",
    "normalize_advantages": true,
    "max_grad_norm": 1.0,
    "target_kl": 0.01,
    "use_gae": true,
    "use_accelerate": false,
    "accelerate_config_path": null,
    "mixed_precision": "bf16",
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": false,
    "offload_optimizer_to_cpu": false,
    "offload_param_to_cpu": false,
    "load_optimizer_states": true,
    "num_gpus": 1,
    "local_rank": -1,
    "world_size": 1,
    "max_gpu_memory": "32GiB",
    "max_cpu_memory": "80GiB",
    "entropy_coef": 0.01
  },
  "model": {
    "model_name": "debug-agent-fast",
    "hf_checkpoint": "meta-llama/Llama-3.2-1B-Instruct",
    "action_branches": 1,
    "rejection_candidates": 1,
    "use_high_level_policy": true,
    "high_level_policy_type": "dqn",
    "hybrid_policy_enabled": false,
    "hybrid_temperature": 0.8,
    "high_level_lr": 0.001,
    "keep_base_on_cpu": false,
    "use_lora": true,
    "lora_r": 4,
    "lora_alpha": 8,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "v_proj"
    ],
    "target_layers": [
      0,
      1
    ],
    "target_model": null,
    "value_loss_coef": 0.5,
    "sequence_value_coef": 0.5,
    "token_value_coef": 0.5,
    "attention_divergence_weight": 0.001,
    "adapter_path": null,
    "sequence_critic_path": null,
    "token_critic_path": null,
    "high_level_policy_path": null,
    "merge_adapters": false,
    "quantize": false,
    "templates_path": "src/configs/templates.json",
    "scorecard_path": "scorecard.json",
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay": 1000,
    "replay_size": 1000,
    "dqn_batch_size": 32,
    "target_update_freq": 100,
    "dqn_gamma": 0.99
  },
  "environment": {
    "data_path": "HarmBench/",
    "harm_threshold": 1.9,
    "max_steps": 1,
    "max_new_tokens": 20,
    "batch_size": 4,
    "target_model": "meta-llama/Llama-3.1-8B-Instruct",
    "guard_model": "meta-llama/Llama-Guard-3-8B",
    "target_quantize": false,
    "guard_quantize": false
  }
}