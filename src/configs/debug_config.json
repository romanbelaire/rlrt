{
  "agent_name": "debug-test-fast",
  "device": "cuda:0",
  "critic_device": "cuda:0",
  "training": {
    "lr": 5e-5,
    "value_lr": 0.001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip": 0.2,
    "eps": 0.2,
    "batch_size": 2,
    "minibatch_size": 2,
    "epochs": 1,
    "episodes": 2,
    "rollout_steps": 1,
    "save_freq": 1,
    "debug_mode": true,
    "ce_coef": 0.5,
    "kl_coef": 0.01,
    "adv_coef": 0.1,
    "sem_coef": 0.1,
    "perplexity_coef": 0.01,
    "seed": null,
    "alg": "ppo",
    "attack_type": "standard",
    "output_dir": "outputs/debug-fast",
    "normalize_advantages": true,
    "max_grad_norm": 1.0,
    "target_kl": 0.01,
    "use_gae": true,
    "use_accelerate": false,
    "accelerate_config_path": null,
    "mixed_precision": "bf16",
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": false,
    "offload_optimizer_to_cpu": false,
    "offload_param_to_cpu": false,
    "load_optimizer_states": false,
    "num_masked_marginal_tokens": 1,
    "pairwise_marginal_masking": true,
    "enable_model_swapping": false,
    "num_gpus": 1,
    "local_rank": -1,
    "world_size": 1,
    "max_gpu_memory": "20GiB",
    "max_cpu_memory": "32GiB",
    "use_offloading": false,
    "warmup_rollout_steps": 1,
    "use_warmup": true
  },
  "model": {
    "model_name": "debug-agent-fast",
    "hf_checkpoint": "meta-llama/Llama-3.2-1B-Instruct",
    "action_branches": 1,
    "rejection_candidates": 1,
    "use_high_level_policy": true,
    "high_level_policy_type": "hybrid",
    "hybrid_policy_enabled": true,
    "hybrid_temperature": 0.8,
    "high_level_lr": 0.001,
    "keep_base_on_cpu": false,
    "use_lora": true,
    "lora_r": 4,
    "lora_alpha": 8,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "v_proj", "gate_proj"],
    "target_layers": [0, 1],
    "target_model": null,
    "detune": false,
    "value_loss_coef": 0.5,
    "sequence_value_coef": 0.5,
    "token_value_coef": 0.5,
    "attention_divergence_weight": 0.001,
    "adapter_path": null,
    "sequence_critic_path": null,
    "token_critic_path": null,
    "high_level_policy_path": null,
    "merge_adapters": false,
    "ds_config_path": "src/configs/ds_zero3_cpu.json",
    "quantize": false
  },
  "environment": {
    "data_path": "HarmBench/",
    "harm_threshold": 1.9,
    "max_steps": 1, 
    "max_new_tokens": 20,
    "batch_size": 4,
    "target_model": "meta-llama/Llama-3.1-8B-Instruct",
    "guard_model": "meta-llama/Llama-Guard-3-1B",
    "use_custom_reward": false,
    "reward_model_path": null,
    "target_quantize": false,
    "guard_quantize": false
  }
} 