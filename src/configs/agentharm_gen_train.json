{
  "agent_name": "agentharm-gen-red-team-train",
  "device": "cuda:0",
  "critic_device": "cuda:0",
  "training": {
    "lr": 0.0005,
    "value_lr": 0.0005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip": 0.1,
    "eps": 0.2,
    "batch_size": 4,
    "minibatch_size": 4,
    "epochs": 1,
    "episodes": 50,
    "rollout_steps": 8,
    "save_freq": 25,
    "debug_mode": false,
    "entropy_coef": 0.1,
    "kl_coef": 0.5,
    "perplexity_coef": 0.0,
    "base_model_kl_coef": 0.2,
    "seed": 42,
    "alg": "ppo",
    "attack_type": "standard",
    "output_dir": "outputs/agentharm-gen-red-team-train",
    "normalize_advantages": true,
    "max_grad_norm": 1.0,
    "target_kl": 0.01,
    "use_gae": true,
    "use_linear_annealing": true,
    "annealing_start_factor": 1.0,
    "annealing_end_factor": 0.1,
    "annealing_warmup_episodes": 10,
    "use_accelerate": true,
    "mixed_precision": "bf16",
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": true,
    "num_gpus": 1,
    "use_freeform_high_level": true,
    "freeform_compute_log_probs_chunk_size": 4,
    "use_task_reward": false,
    "reward_coef": 3.0,
    "use_rs_minus_ra_reward": false,
    "use_per_token_advantages": true,
    "num_masked_marginal_tokens": 5
  },
  "model": {
    "model_name": "agentharm-gen-red-team",
    "hf_checkpoint": "HuggingFaceH4/zephyr-7b-beta",
    "action_branches": 1,
    "rejection_candidates": 1,
    "use_high_level_policy": true,
    "use_tool_index_policy": true,
    "tool_registry_path": "src/agentharm_gen/generated/tool_registry.json",
    "high_level_lr": 0.001,
    "use_lora": true,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj"],
    "high_level_policy_type": "freeform",
    "freeform_max_new_tokens": 48,
    "freeform_temperature": 0.8,
    "freeform_top_p": 0.9,
    "quantize": false,
    "tool_index_lr": 0.0001,
    "tool_index_gamma": 0.99,
    "tool_index_epsilon_start": 1.0,
    "tool_index_epsilon_end": 0.05,
    "tool_index_epsilon_decay": 350,
    "tool_index_replay_size": 50000,
    "tool_index_batch_size": 64,
    "tool_index_target_update_freq": 1000,
    "tool_index_max_chunk_size": 2,
    "tool_index_max_seq_length": 2048,
    "l1_option_max_steps": 5
  },
  "environment": {
    "env_task": "agentharm_gen",
    "max_steps": 10,
    "max_new_tokens": 4096,
    "batch_size": 4,
    "target_model": "meta-llama/Llama-3.1-8B-Instruct",
    "guard_model": null,
    "lmrl_options": {
      "tasks_path": "src/agentharm_gen/generated/tasks.jsonl",
      "tool_registry_path": "src/agentharm_gen/generated/tool_registry.json",
      "n_irrelevant_tools": 5,
      "refusal_judge": "openai/gpt-4o-2024-08-06",
      "semantic_judge": "openai/gpt-4o-2024-08-06",
      "defender_tool_choice": "auto",
      "defender_prompt_technique": "standard",
      "max_defender_tool_rounds": 20,
      "harm_threshold": 0.5,
      "refusal_penalty": 0.0,
      "defender_temperature": 0.0
    }
  }
}
