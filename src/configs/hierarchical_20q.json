{
  "training": {
    "lr": 0.05,
    "value_lr": 0.0005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip": 0.1,
    "eps": 0.2,
    "batch_size": 16,
    "minibatch_size": 8,
    "rollout_steps": 320,
    "max_new_tokens": 200,
    "episodes": 500,
    "epochs": 3,
    "entropy_coef": 0.01,
    "perplexity_coef": 0.8,
    "max_grad_norm": 1.0,
    "seed": 42,
    "save_freq": 50,
    "output_dir": "outputs/hierarchical_20q",
    
    "hl_only_training": true,
    "use_skywork_for_token_critic": true,
    "skywork_model_name": "Skywork/Skywork-Reward-V2-Llama-3.1-8B",
    "skywork_eval_batch_size": 128,
    
    "use_per_token_advantages": true,
    "use_task_reward": true,
    
    "gradient_checkpointing": true,
    "chunked_forward_pass": true,
    "enable_model_swapping": false,
    "use_rs_minus_ra_reward": false,
    
    "chunk_size": 16,
    "use_first_layer_attention_only": true,
    "actor_chunking_enabled": true,
    "actor_max_chunk_size": 8,
    "actor_memory_fraction": 0.5,
    "critic_chunking_threshold": 16,
    "critic_max_chunk_size": 16,
    "critic_memory_fraction": 0.4,
    "max_gpu_memory": 0.85,
    "dynamic_batch_sizing": true,
    
    "use_accelerate": true,
    "mixed_precision": "bf16",
    "gradient_accumulation_steps": 4,
    "use_linear_annealing": true,
    "normalize_advantages": true,
    "target_kl": 0.01,
    "use_gae": true
  },
  "model": {
    "hf_checkpoint": "meta-llama/Llama-3.1-8B-Instruct",
    "use_lora": true,
    "lora_r": 4,
    "lora_alpha": 4,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ],
    "target_layers": [0, 2, 4, 6],
    
    "use_high_level_policy": true,
    "high_level_policy_type": "llm",
    
    "value_loss_coef": 0.5,
    "sequence_value_coef": 0.5,
    "token_value_coef": 0.5,
    "quantize": false
  },
  "environment": {
    "use_mcq_env": false,
    "env_task": "hierarchical_twenty_questions",
    "batch_size": 16,
    "max_new_tokens": 5,
    "lmrl_options": {
      "oracle_model_name": "meta-llama/Llama-3.1-8B-Instruct",
      "oracle_quantize": 4,
      "judge_model_name": "meta-llama/Llama-3.2-1B-Instruct",
      "judge_quantize": 4,
      "max_conversation_length": 20,
      "hl_reward_success": 0.0,
      "hl_reward_failure": -1.0,
      "ll_reward_range": [0.0, 1.0],
      "hf_token": null
    },
    "harm_threshold": 1.5,
    "max_steps": 20,
    "similarity_weight": 0.1,
    "target_quantize": false,
    "guard_quantize": false,
    "judge_batch_size": 256
  }
}